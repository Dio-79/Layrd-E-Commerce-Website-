# Copy this file to .env.local (in this lyard folder) and fill in the values.
# Never commit .env.local. Ask Abel for the Firebase values; the Square/PayPal
# ones come from their developer dashboards (see PAYMENTS.md).

# Firebase (console.firebase.google.com → project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=layrd-ecommerce-abel
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=layrd-ecommerce-abel.firebaseapp.com
GCLOUD_PROJECT=layrd-ecommerce-abel

# Server key from Firebase console → Project settings → Service accounts → Generate new private key.
# Save the JSON file OUTSIDE the repo and put its full path here.
FIREBASE_SERVICE_ACCOUNT_FILE=C:\Users\you\.layrd\firebase-service-account.json

# Lets staff change preorder status with PATCH (see app/api/*-preorders/route.ts). Any long random text.
BUNDLE_ADMIN_KEY=
EVENT_ADMIN_KEY=

# Payments (optional; a method only shows at checkout when its settings are filled in). See PAYMENTS.md.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
NEXT_PUBLIC_ETRANSFER_EMAIL=
